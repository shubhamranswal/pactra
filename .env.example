# WalletConnect Cloud Project ID (get one at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Monad Testnet RPC URL override (optional)
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed PactEscrow Contract Address
VITE_PACT_ESCROW_ADDRESS=

# Gemini API Key (Server-only, never expose to frontend as VITE_GEMINI_API_KEY)
GEMINI_API_KEY=
